# Exact release to deploy. Floating tags such as "latest" are intentionally unsupported.
IMAGE_REPOSITORY=ghcr.io/geniuslv2006/xjtlu-timetable
IMAGE_TAG=v0.3.1

# Bind only to the local host by default. Put an HTTPS reverse proxy in front.
BIND_ADDRESS=127.0.0.1
HOST_PORT=8091

# Persistent PocketBase data and an isolated Compose project name.
DATA_DIR=./data
COMPOSE_PROJECT_NAME=xjtlu-timetable

# Keep this stable after users subscribe. Set it to this instance's hostname.
ICAL_UID_DOMAIN=xjtlu-timetable.invalid

# Required. Generate a private value with `openssl rand -hex 32` and never
# commit the populated .env file. Put the newest key first; retain older keys,
# comma-separated, until identifiers created with them have expired.
ACCOUNT_BLOCK_HMAC_KEYS=
