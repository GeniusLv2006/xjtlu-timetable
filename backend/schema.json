[
  {
    "name": "timetables",
    "type": "base",
    "system": false,
    "schema": [
      {
        "name": "user",
        "type": "relation",
        "required": true,
        "options": {
          "collectionId": "_pb_users_auth_",
          "cascadeDelete": true,
          "minSelect": null,
          "maxSelect": 1,
          "displayFields": null
        }
      },
      {
        "name": "hash",
        "type": "text",
        "required": false,
        "options": { "min": null, "max": null, "pattern": "" }
      },
      {
        "name": "label",
        "type": "text",
        "required": false,
        "options": { "min": null, "max": null, "pattern": "" }
      },
      {
        "name": "visibility",
        "type": "select",
        "required": false,
        "options": {
          "maxSelect": 1,
          "values": ["public", "friends", "private"]
        }
      },
      {
        "name": "last_synced",
        "type": "date",
        "required": false,
        "options": { "min": "", "max": "" }
      }
    ],
    "indexes": [
      "CREATE INDEX `idx_timetables_user_hash` ON `timetables` (`user`, `hash`)"
    ],
    "listRule": "@request.auth.id = user.id || visibility = \"public\" || (visibility = \"friends\" && ((@collection.friendships.from_user.id ?= @request.auth.id && @collection.friendships.to_user.id ?= user.id && @collection.friendships.status ?= \"accepted\") || (@collection.friendships.to_user.id ?= @request.auth.id && @collection.friendships.from_user.id ?= user.id && @collection.friendships.status ?= \"accepted\")))",
    "viewRule": "@request.auth.id = user.id || visibility = \"public\" || (visibility = \"friends\" && ((@collection.friendships.from_user.id ?= @request.auth.id && @collection.friendships.to_user.id ?= user.id && @collection.friendships.status ?= \"accepted\") || (@collection.friendships.to_user.id ?= @request.auth.id && @collection.friendships.from_user.id ?= user.id && @collection.friendships.status ?= \"accepted\")))",
    "createRule": "@request.auth.id = user.id",
    "updateRule": "@request.auth.id = user.id && @request.body.user:changed = false",
    "deleteRule": "@request.auth.id = user.id"
  },
