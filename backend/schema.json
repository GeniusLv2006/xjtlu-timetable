  {
    "name": "friendships",
    "type": "base",
    "system": false,
    "schema": [
      {
        "name": "from_user",
        "type": "relation",
        "required": true,
        "options": {
          "collectionId": "_pb_users_auth_",
          "cascadeDelete": true,
          "minSelect": null,
          "maxSelect": 1,
          "displayFields": null
        }
      },
      {
        "name": "to_user",
        "type": "relation",
        "required": true,
        "options": {
          "collectionId": "_pb_users_auth_",
          "cascadeDelete": true,
          "minSelect": null,
          "maxSelect": 1,
          "displayFields": null
        }
      },
      {
        "name": "status",
        "type": "select",
        "required": false,
        "options": {
          "maxSelect": 1,
          "values": ["pending", "accepted"]
        }
      }
    ],
    "indexes": [
      "CREATE INDEX `idx_friendships_from_status` ON `friendships` (`from_user`, `status`)",
      "CREATE INDEX `idx_friendships_to_status` ON `friendships` (`to_user`, `status`)"
    ],
    "listRule": "@request.auth.id = from_user.id || @request.auth.id = to_user.id",
    "viewRule": "@request.auth.id = from_user.id || @request.auth.id = to_user.id",
    "createRule": "@request.auth.id = from_user.id && @request.body.status = \"pending\"",
    "updateRule": "@request.auth.id = to_user.id && @request.body.from_user:changed = false && @request.body.to_user:changed = false && @request.body.status = \"accepted\"",
    "deleteRule": "@request.auth.id = from_user.id || @request.auth.id = to_user.id"
  },
